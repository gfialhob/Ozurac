{
  "name": "Ozurac Soft",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "enumMember": {
      "foreground": "#56b6c2"
    },
    "variable.constant": {
      "foreground": "#d19a66"
    },
    "variable.defaultLibrary": {
      "foreground": "#e5c07b"
    }
  },
  "tokenColors": [
    {
      "name": "Blocos embutidos e imagens inline Markdown",
      "scope": [
        "meta.embedded",
        "source.groovy.embedded",
        "string meta.image.inline.markdown"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Ênfase (itálico)",
      "scope": "emphasis",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Destaque forte (negrito)",
      "scope": "strong",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Cabeçalhos (Diff / Markup)",
      "scope": "header",
      "settings": {
        "foreground": "#00c97a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Constantes de linguagem (true, false, null)",
      "scope": "constant.language",
      "settings": {
        "foreground": "#d19a66"
      }
    },
    {
      "name": "Números e expoentes",
      "scope": [
        "constant.numeric",
        "keyword.operator.plus.exponent",
        "keyword.operator.minus.exponent"
      ],
      "settings": {
        "foreground": "#B5CEA8"
      }
    },
    {
      "name": "Constantes RegExp",
      "scope": "constant.regexp",
      "settings": {
        "foreground": "#646695"
      }
    },
    {
      "name": "Tags HTML/XML",
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#00c97a"
      }
    },
    {
      "name": "Tags CSS",
      "scope": "entity.name.tag.css",
      "settings": {
        "foreground": "#e5c07b"
      }
    },
    {
      "name": "Atributos HTML/XML",
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#e5c07b"
      }
    },
    {
      "name": "Seletores e classes CSS/SCSS/LESS",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.class.mixin.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.parent-selector.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css",
        "source.css.less entity.other.attribute-name.id",
        "entity.other.attribute-name.scss"
      ],
      "settings": {
        "foreground": "#d19a66"
      }
    },
    {
      "name": "Código inválido",
      "scope": "invalid",
      "settings": {
        "foreground": "#F44747"
      }
    },
    {
      "name": "Sublinhado (Markup)",
      "scope": "markup.underline",
      "settings": {
        "fontStyle": "underline"
      }
    },
    {
      "name": "Negrito (Markup)",
      "scope": "markup.bold",
      "settings": {
        "foreground": "#00c97a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Títulos (Markup)",
      "scope": "markup.heading",
      "settings": {
        "foreground": "#00c97a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Itálico (Markup)",
      "scope": "markup.italic",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tachado (Markup)",
      "scope": "markup.strikethrough",
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Linhas inseridas (Diff/Markup)",
      "scope": "markup.inserted",
      "settings": {
        "foreground": "#B5CEA8"
      }
    },
    {
      "name": "Linhas removidas (Diff/Markup)",
      "scope": "markup.deleted",
      "settings": {
        "foreground": "#CE9178"
      }
    },
    {
      "name": "Linhas alteradas (Diff/Markup)",
      "scope": "markup.changed",
      "settings": {
        "foreground": "#56b6c2"
      }
    },
    {
      "name": "Citação Markdown",
      "scope": "punctuation.definition.quote.begin.markdown",
      "settings": {
        "foreground": "#5c7a68"
      }
    },
    {
      "name": "Marcador de lista Markdown",
      "scope": "punctuation.definition.list.begin.markdown",
      "settings": {
        "foreground": "#00c97a"
      }
    },
    {
      "name": "Código inline Markdown",
      "scope": "markup.inline.raw",
      "settings": {
        "foreground": "#CE9178"
      }
    },
    {
      "name": "Pontuação de tags (<, >, />)",
      "scope": "punctuation.definition.tag",
      "settings": {
        "foreground": "#808080"
      }
    },
    {
      "name": "Diretivas de pré-processador",
      "scope": [
        "meta.preprocessor",
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#56b6c2"
      }
    },
    {
      "name": "Strings de pré-processador",
      "scope": "meta.preprocessor.string",
      "settings": {
        "foreground": "#CE9178"
      }
    },
    {
      "name": "Números de pré-processador",
      "scope": "meta.preprocessor.numeric",
      "settings": {
        "foreground": "#B5CEA8"
      }
    },
    {
      "name": "Propriedades (chaves de dicionário Python)",
      "scope": "meta.structure.dictionary.key.python",
      "settings": {
        "foreground": "#56b6c2"
      }
    },
    {
      "name": "Cabeçalho de Diff",
      "scope": "meta.diff.header",
      "settings": {
        "foreground": "#56b6c2"
      }
    },
    {
      "name": "Storage (function, class, let, var, const)",
      "scope": "storage",
      "settings": {
        "foreground": "#00c97a"
      }
    },
    {
      "name": "Tipos de storage (class, struct, interface)",
      "scope": "storage.type",
      "settings": {
        "foreground": "#00c97a"
      }
    },
    {
      "name": "Modificadores (public, private, static)",
      "scope": [
        "storage.modifier",
        "keyword.operator.noexcept"
      ],
      "settings": {
        "foreground": "#00c97a"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "meta.embedded.assembly"
      ],
      "settings": {
        "foreground": "#CE9178"
      }
    },
    {
      "name": "Strings (atributos de tag)",
      "scope": "string.tag",
      "settings": {
        "foreground": "#CE9178"
      }
    },
    {
      "name": "Strings (valores)",
      "scope": "string.value",
      "settings": {
        "foreground": "#CE9178"
      }
    },
    {
      "name": "Strings RegExp",
      "scope": "string.regexp",
      "settings": {
        "foreground": "#D16969"
      }
    },
    {
      "name": "Delimitadores de template string (${})",
      "scope": [
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#00c97a"
      }
    },
    {
      "name": "Expressões dentro de template string",
      "scope": [
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Propriedades (CSS/SCSS/LESS)",
      "scope": [
        "support.type.vendored.property-name",
        "support.type.property-name",
        "variable.css",
        "variable.scss",
        "variable.other.less",
        "source.coffee.embedded"
      ],
      "settings": {
        "foreground": "#56b6c2"
      }
    },
    {
      "name": "Keywords gerais",
      "scope": "keyword",
      "settings": {
        "foreground": "#00c97a"
      }
    },
    {
      "name": "Keywords de controle (if/else/for/while/return)",
      "scope": [
        "keyword.control",
        "source.cpp keyword.operator.new",
        "keyword.operator.delete",
        "keyword.other.using",
        "keyword.other.operator",
        "entity.name.operator"
      ],
      "settings": {
        "foreground": "#00c97a"
      }
    },
    {
      "name": "Operadores (+, -, =, etc.)",
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#d4d4d4"
      }
    },
    {
      "name": "Operadores por extenso (new, instanceof, sizeof)",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.cast",
        "keyword.operator.sizeof",
        "keyword.operator.alignof",
        "keyword.operator.typeid",
        "keyword.operator.alignas",
        "keyword.operator.instanceof",
        "keyword.operator.logical.python",
        "keyword.operator.wordlike"
      ],
      "settings": {
        "foreground": "#d4d4d4"
      }
    },
    {
      "name": "Unidades CSS (px, rem, em, %)",
      "scope": "keyword.other.unit",
      "settings": {
        "foreground": "#B5CEA8"
      }
    },
    {
      "name": "Tags de abertura/fechamento PHP",
      "scope": [
        "punctuation.section.embedded.begin.php",
        "punctuation.section.embedded.end.php"
      ],
      "settings": {
        "foreground": "#00c97a"
      }
    },
    {
      "name": "Comandos Git Rebase",
      "scope": "support.function.git-rebase",
      "settings": {
        "foreground": "#56b6c2"
      }
    },
    {
      "name": "Hashes SHA Git Rebase",
      "scope": "constant.sha.git-rebase",
      "settings": {
        "foreground": "#B5CEA8"
      }
    },
    {
      "name": "Imports e pacotes Java",
      "scope": [
        "storage.modifier.import.java",
        "variable.language.wildcard.java",
        "storage.modifier.package.java"
      ],
      "settings": {
        "foreground": "#ffffff"
      }
    },
    {
      "name": "Variáveis de linguagem (this, self, super)",
      "scope": "variable.language",
      "settings": {
        "foreground": "#00c97a"
      }
    },
    {
      "name": "Funções",
      "scope": [
        "entity.name.function",
        "source.powershell variable.other.member",
        "entity.name.operator.custom-literal"
      ],
      "settings": {
        "foreground": "#e5c07b"
      }
    },
    {
      "name": "Funções especiais (nativas/built-in)",
      "scope": [
        "support.function",
        "support.constant.handlebars"
      ],
      "settings": {
        "foreground": "#56b6c2"
      }
    },
    {
      "name": "Métodos",
      "scope": [
        "meta.function.method",
        "entity.name.function.member",
        "variable.function"
      ],
      "settings": {
        "foreground": "#d4be7a"
      }
    },
    {
      "name": "Classes e tipos",
      "scope": [
        "support.class",
        "support.type",
        "entity.name.type",
        "entity.name.namespace",
        "entity.other.attribute",
        "entity.name.scope-resolution",
        "entity.name.class",
        "storage.type.numeric.go",
        "storage.type.byte.go",
        "storage.type.boolean.go",
        "storage.type.string.go",
        "storage.type.uintptr.go",
        "storage.type.error.go",
        "storage.type.rune.go",
        "storage.type.cs",
        "storage.type.generic.cs",
        "storage.type.modifier.cs",
        "storage.type.variable.cs",
        "storage.type.annotation.java",
        "storage.type.generic.java",
        "storage.type.java",
        "storage.type.object.array.java",
        "storage.type.primitive.array.java",
        "storage.type.primitive.java",
        "storage.type.token.java",
        "storage.type.groovy",
        "storage.type.annotation.groovy",
        "storage.type.parameters.groovy",
        "storage.type.generic.groovy",
        "storage.type.object.array.groovy",
        "storage.type.primitive.array.groovy",
        "storage.type.primitive.groovy"
      ],
      "settings": {
        "foreground": "#4EC9B0"
      }
    },
    {
      "name": "Classes (cast, herança, objetos globais)",
      "scope": [
        "meta.type.cast.expr",
        "meta.type.new.expr",
        "support.constant.math",
        "support.constant.dom",
        "support.constant.json",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#4EC9B0"
      }
    },
    {
      "name": "Destaque de herança de classe",
      "scope": "entity.other.inherited-class",
      "settings": {
        "fontStyle": "underline"
      }
    },
    {
      "name": "Variáveis",
      "scope": [
        "variable",
        "meta.definition.variable.name",
        "support.variable",
        "entity.name.variable",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#e5c07b"
      }
    },
    {
      "name": "Constantes (const)",
      "scope": "variable.other.constant",
      "settings": {
        "foreground": "#d19a66"
      }
    },
    {
      "name": "Membros de Enum",
      "scope": "variable.other.enummember",
      "settings": {
        "foreground": "#56b6c2"
      }
    },
    {
      "name": "Propriedades (chaves de objeto)",
      "scope": [
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#56b6c2"
      }
    },
    {
      "name": "Valores de propriedades e cores CSS",
      "scope": [
        "support.constant.property-value",
        "support.constant.font-name",
        "support.constant.media-type",
        "support.constant.media",
        "constant.other.color.rgb-value",
        "constant.other.rgb-value",
        "support.constant.color"
      ],
      "settings": {
        "foreground": "#CE9178"
      }
    },
    {
      "name": "Grupos e classes de caracteres RegExp",
      "scope": [
        "punctuation.definition.group.regexp",
        "punctuation.definition.group.assertion.regexp",
        "punctuation.definition.character-class.regexp",
        "punctuation.character.set.begin.regexp",
        "punctuation.character.set.end.regexp",
        "keyword.operator.negation.regexp",
        "support.other.parenthesis.regexp"
      ],
      "settings": {
        "foreground": "#CE9178"
      }
    },
    {
      "name": "Conjuntos de caracteres RegExp",
      "scope": [
        "constant.character.character-class.regexp",
        "constant.other.character-class.set.regexp",
        "constant.other.character-class.regexp",
        "constant.character.set.regexp"
      ],
      "settings": {
        "foreground": "#D16969"
      }
    },
    {
      "name": "Âncoras e alternância RegExp",
      "scope": [
        "keyword.operator.or.regexp",
        "keyword.control.anchor.regexp"
      ],
      "settings": {
        "foreground": "#DCDCAA"
      }
    },
    {
      "name": "Quantificadores RegExp",
      "scope": "keyword.operator.quantifier.regexp",
      "settings": {
        "foreground": "#D7BA7D"
      }
    },
    {
      "name": "Caracteres especiais e opções",
      "scope": [
        "constant.character",
        "constant.other.option"
      ],
      "settings": {
        "foreground": "#56b6c2"
      }
    },
    {
      "name": "Caracteres de escape",
      "scope": "constant.character.escape",
      "settings": {
        "foreground": "#D7BA7D"
      }
    },
    {
      "name": "Labels",
      "scope": "entity.name.label",
      "settings": {
        "foreground": "#C8C8C8"
      }
    },
    {
      "name": "Comentários e docstrings",
      "scope": [
        "comment",
        "comment.block",
        "string.quoted.docstring",
        "string.quoted.docstring.multi"
      ],
      "settings": {
        "foreground": "#5c7a68",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Delimitadores de comentários e strings",
      "scope": [
        "punctuation.definition.comment",
        "punctuation.definition.string.begin",
        "punctuation.definition.string.end"
      ],
      "settings": {
        "fontStyle": ""
      }
    },
    {
      "name": "Logs: Info",
      "scope": "token.info-token",
      "settings": {
        "foreground": "#6796E6"
      }
    },
    {
      "name": "Logs: Warning",
      "scope": "token.warn-token",
      "settings": {
        "foreground": "#CD9731"
      }
    },
    {
      "name": "Logs: Error",
      "scope": "token.error-token",
      "settings": {
        "foreground": "#F44747"
      }
    },
    {
      "name": "Logs: Debug",
      "scope": "token.debug-token",
      "settings": {
        "foreground": "#B267E6"
      }
    }
  ],
